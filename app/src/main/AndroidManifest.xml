<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Networking: the phone dials OUT to our own relay (rc-relay behind nginx). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Long-lived outbound connection lives in a foreground service.
         `specialUse` is deliberate: Android 16's 6-hour foreground-service
         timeout only applies to `dataSync` and `mediaProcessing`, so a
         `specialUse` service can hold the connection indefinitely. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets the operator opt this app out of Doze/App-Standby from inside the
         app instead of hunting through system settings. Without the exemption
         the phone freezes the long poll once the screen goes off, which the
         relay sees as "offline" (measured: heartbeat gaps of 138 s, 151 s and
         a whole-night 9705 s). Sideloaded, so Play's policy does not apply. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Location. ACCESS_BACKGROUND_LOCATION is required for reports sent while
         the app has no visible activity; without it we can only read a fix
         while the user has the app open. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- `list_apps` / `open_app` need to see other packages on API 30+. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Lets the installer UI read the APK we hand it as content:// (see
         ApkProvider). Without this app-op the system shows its own warning and
         refuses, which is reported as a normal error by `install`. -->
    <!-- `adbinfo` / `adbheal` listen for the `_adb-tls-connect._tcp` mDNS
         advertisement. The multicast lock is a normal permission; without it
         several ROMs drop the mDNS packet before it ever reaches an app. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- ================== PRIVILEGED ==================
         Two families, and only one of them is reachable from a sideloaded app:

         signature|privileged|development — grantable with
             `adb shell pm grant net.de5.phoneagent <permission>`,
         because the `development` flag exists precisely for this. These are the
         permissions the privileged commands are actually built on, and each is
         checked at runtime with checkSelfPermission.

         signature|privileged (INSTALL_PACKAGES / DELETE_PACKAGES / REBOOT) —
         platform-signed or /system/priv-app only. **Device Owner is not enough
         and pm grant is refused**, so no command may assume them: install and
         uninstall go through the system confirmation UI (`confirm` presses the
         button), and reboot reports why it cannot. Declaring them here is
         harmless and keeps the door open if this is ever pushed to priv-app. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.DUMP" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.REBOOT" />
    <uses-permission android:name="android.permission.DEVICE_POWER" />

    <!-- ============== v0.4.0 DEVICE SURFACE ==============
         What the seven new groups need, and — the point of this block — which
         grant each one actually takes. Three different mechanisms, and using the
         wrong one is how a command ships looking implemented but dead:

         pm grant (dangerous / development runtime permissions):
             READ_SMS, SEND_SMS, RECEIVE_SMS, READ_CALL_LOG, WRITE_CALL_LOG,
             CALL_PHONE, ANSWER_PHONE_CALLS, READ_PHONE_STATE, READ_PHONE_NUMBERS,
             READ_CONTACTS, RECORD_AUDIO, READ_MEDIA_AUDIO, READ_MEDIA_IMAGES,
             READ_MEDIA_VIDEO, READ_EXTERNAL_STORAGE, WRITE_EXTERNAL_STORAGE,
             READ_CALENDAR, WRITE_CALENDAR, BODY_SENSORS, ACTIVITY_RECOGNITION,
             SYSTEM_ALERT_WINDOW*  (*appop, see below)

         appops (a system toggle, pm grant silently does nothing):
             MANAGE_EXTERNAL_STORAGE — `files` reads other apps' files.
             SYSTEM_ALERT_WINDOW — overlay.
             ACCESS_NOTIFICATION_POLICY — Do Not Disturb.
         The exact adb lines live in Admin.extendedReport (printed by
         `admin status`), because an XML comment cannot contain a double dash.

         user toggle in settings (no adb shortcut that is portable):
             notification listener ("通知使用权") for `notif`; the adb form
             `cmd notification allow_listener` exists on most ROMs.

         signature|privileged, declared for a future priv-app build only and
         NEVER relied on: SET_ANIMATION_SCALE (the anim command writes
         Settings.Global instead, which only needs WRITE_SECURE_SETTINGS),
         MODIFY_PHONE_STATE. -->

    <!-- Calls: dial, answer, hang up, and the state report. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- SMS: list and send. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Contacts and calendar: read-only surfaces the operator asks about. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Audio: `rec` records, `say` needs nothing beyond a TTS engine. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Media read for `files` and future gallery work. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Legacy storage spellings: on API 31/32 READ_EXTERNAL_STORAGE is still
         the runtime grant that makes /sdcard readable; on 33+ the per-type
         READ_MEDIA_* above take over. Both are declared so the same APK works on
         the Android 12 tablet and the Android 16 phone. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Overlay and Do Not Disturb: both are app-ops, not runtime grants. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Animation scales. Declared so a priv-app build could use it; the anim
         command writes Settings.Global through WRITE_SECURE_SETTINGS instead. -->
    <uses-permission android:name="android.permission.SET_ANIMATION_SCALE" />

    <!-- Sensor and activity surfaces: cheap to hold, and they answer "is the
         phone moving / what is it doing" without another app's help. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Clipboard and screen wake lock for the `text`/`wake` paths already in
         use; declared here so the whole surface is in one block. -->
    <uses-permission android:name="android.permission.READ_CLIPBOARD" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <application
        android:allowBackup="false"
        android:requestLegacyExternalStorage="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!-- ===================== UI ===================== -->
        <!-- Where the operator types relay URL + secret and switches the agent on.
             Kept deliberately minimal: an Activity, not Compose. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ================== AGENT CORE ================== -->
        <!-- Holds the outbound long-poll to the relay. Runs until explicitly
             stopped; restarted from BootReceiver and from MainActivity. -->
        <service
            android:name=".RcAgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="remote_control_agent" />
        </service>

        <!-- Third layer of the `wake` command (SPEC.md section 3.2): a one-shot
             translucent Activity that turns the panel on and clears a non-secure
             keyguard. Invisible and immediately finished; `noHistory` +
             `excludeFromRecents` keep it out of the task list. -->
        <activity
            android:name=".WakeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ================= ACCESSIBILITY ================= -->
        <!-- The only "hands and eyes" we have: read the window tree, inject
             gestures, take screenshots without MediaProjection prompts. -->
        <service
            android:name=".PhoneAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ============ NOTIFICATION LISTENER ============
             The only way to read other apps' notifications. Not a runtime
             permission: either the operator turns on "通知使用权" or the grant is
             `adb shell cmd notification allow_listener
             net.de5.phoneagent/net.de5.phoneagent.NotifListenerService`.
             `notif` prints that exact line whenever the listener is not bound. -->
        <service
            android:name=".NotifListenerService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ================= DEVICE ADMIN / OWNER =================
             BIND_DEVICE_ADMIN is what makes this receiver reachable from the
             system's admin framework; `device_admin.xml` lists the policies we
             declare (lockNow / reboot / setGlobalSetting need them).
             Being a *registered admin* and being *Device Owner* are different
             grants: the admin flag alone allows lockNow, while silent install,
             uninstall and reboot require the owner role, which is only
             obtainable at provisioning time. -->
        <receiver
            android:name=".AgentDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- ================= APK HAND-OFF =================
             Read-only, not exported: the only reader is whichever component we
             grant a `content://` URI to from `install`, via the Intent flag.
             Exists because a file:// URI in an Intent throws
             FileUriExposedException since Android 7. -->
        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- ==================== BOOT ==================== -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
