<?xml version="1.0" encoding="utf-8"?>
<!--
  Accessibility service configuration.

  canRetrieveWindowContent : we read the node tree (ui_tree command).
  canPerformGestures       : we inject taps/swipes (tap/swipe commands).
  canTakeScreenshot        : API 30+, lets us grab the screen with no
                             MediaProjection consent dialog.
  flagRetrieveInteractiveWindows : needed to enumerate every window (dialogs,
                             IME) rather than only the active one.
  flagReportViewIds        : gives us resource ids, which make the tree
                             far easier to target than raw text.

  Event types: we subscribe to content changes as well as window changes, and
  onAccessibilityEvent stays empty - we collect the events and do nothing with
  them. The old comment here said the opposite ("it fires constantly"), but the
  cost of an empty callback is nil and the cost of NOT subscribing is real: the
  framework only keeps a window's content cache current for the event types a
  service asked for, so without typeWindowContentChanged getRootInActiveWindow
  hands back the snapshot from the last window event. Measured on the real phone
  (v0.6.0-pad12): expanding 高级设置 drew three EditTexts and tree kept answering
  0 after one second, after six seconds and after a scroll; only re-activating
  the window refreshed it. If tree ever goes stale again, check this line first.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged|typeWindowContentChanged|typeViewClicked|typeViewFocused|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:settingsActivity="net.de5.phoneagent.MainActivity" />
